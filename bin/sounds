#!/usr/bin/env python3
# Synthesizes Fireteam's interface sounds into src/sounds/: short, quiet, and
# original. Run it again after changing a sound; the .wav files are committed.
import math, os, random, struct, wave

RATE = 44100
OUT = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "src", "sounds")
random.seed(7)


def write(name, samples, gain=0.6):
    peak = max(1e-9, max(abs(s) for s in samples))
    with wave.open(os.path.join(OUT, name), "wb") as w:
        w.setnchannels(1)
        w.setsampwidth(2)
        w.setframerate(RATE)
        w.writeframes(b"".join(struct.pack("<h", int(32767 * gain * s / peak)) for s in samples))


def env(i, n, attack=0.005, release=0.5):
    t = i / RATE
    dur = n / RATE
    a = min(1, t / attack) if attack > 0 else 1
    r = max(0, 1 - max(0, t - (dur - dur * release)) / (dur * release)) if release > 0 else 1
    return a * r


def tone(freqs, dur, attack=0.004, release=0.6, glide=None):
    n = int(RATE * dur)
    out = []
    phase = [0.0] * len(freqs)
    for i in range(n):
        t = i / RATE
        v = 0
        for k, f in enumerate(freqs):
            f2 = f * (1 + (glide - 1) * t / dur) if glide else f
            phase[k] += 2 * math.pi * f2 / RATE
            v += math.sin(phase[k]) + 0.25 * math.sin(2 * phase[k])
        out.append(v * env(i, n, attack, release))
    return out


def noise(dur, lowpass=0.2, attack=0.01, release=0.7, sweep=None):
    n = int(RATE * dur)
    out = []
    y = 0
    for i in range(n):
        a = lowpass if not sweep else lowpass + (sweep - lowpass) * i / n
        y += a * (random.uniform(-1, 1) - y)
        out.append(y * env(i, n, attack, release))
    return out


def mix(*parts):
    n = max(len(p) + int(o * RATE) for p, o in parts)
    out = [0.0] * n
    for p, offset in parts:
        o = int(offset * RATE)
        for i, s in enumerate(p):
            out[o + i] += s
    return out


# Hover: a tiny dry tick.
write("tick.wav", mix((tone([2400], 0.018, release=0.9), 0), (noise(0.012, 0.6, 0.001, 0.9), 0)), 0.25)
# Select: two quick blips upward.
write("select.wav", mix((tone([880], 0.05), 0), (tone([1320], 0.07), 0.045)), 0.35)
# Open a panel: a short airy rise.
write("open.wav", mix((noise(0.22, 0.05, 0.03, 0.6, 0.35), 0), (tone([440], 0.22, glide=1.8, release=0.8), 0)), 0.3)
# Deploy: a low thump, a rising sweep, and a radio chirp.
write("deploy.wav", mix(
    (tone([55, 82], 0.5, attack=0.002, release=0.9), 0),
    (noise(0.9, 0.02, 0.2, 0.5, 0.4), 0.05),
    (tone([330], 0.7, glide=2.4, release=0.5), 0.15),
    (tone([1760], 0.05), 0.92), (tone([2200], 0.05), 0.98)), 0.55)
# Cycle done: a bright two-note confirmation.
write("done.wav", mix((tone([659, 988], 0.18), 0), (tone([988, 1318], 0.32, release=0.8), 0.12)), 0.4)
# Operation complete: a rising three-note figure.
write("complete.wav", mix((tone([523], 0.2), 0), (tone([659], 0.2), 0.14),
                          (tone([784, 1046], 0.55, release=0.85), 0.28)), 0.45)
# Waiting on the operator: a radio squelch and two quick calls.
write("radio.wav", mix((noise(0.12, 0.5, 0.002, 0.8), 0), (tone([1480], 0.06), 0.14), (tone([1480], 0.06), 0.26)), 0.4)
# Failure: a descending low buzz.
write("fail.wav", mix((tone([196, 207], 0.55, glide=0.6, release=0.7), 0), (noise(0.4, 0.08, 0.005, 0.8), 0)), 0.45)
