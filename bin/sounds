#!/usr/bin/env python3
# Synthesizes Fireteam's interface sounds into src/sounds/: short, quiet, and
# original. Run it again after changing a sound; the .wav files are committed.
import math, os, random, struct, wave

RATE = 44100
OUT = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "src", "sounds")
random.seed(7)


def write(name, samples, gain=0.6):
    peak = max(1e-9, max(abs(s) for s in samples))
    with wave.open(os.path.join(OUT, name), "wb") as w:
        w.setnchannels(1)
        w.setsampwidth(2)
        w.setframerate(RATE)
        w.writeframes(b"".join(struct.pack("<h", int(32767 * gain * s / peak)) for s in samples))


def env(i, n, attack=0.005, release=0.5):
    t = i / RATE
    dur = n / RATE
    a = min(1, t / attack) if attack > 0 else 1
    r = max(0, 1 - max(0, t - (dur - dur * release)) / (dur * release)) if release > 0 else 1
    return a * r


def tone(freqs, dur, attack=0.004, release=0.6, glide=None):
    n = int(RATE * dur)
    out = []
    phase = [0.0] * len(freqs)
    for i in range(n):
        t = i / RATE
        v = 0
        for k, f in enumerate(freqs):
            f2 = f * (1 + (glide - 1) * t / dur) if glide else f
            phase[k] += 2 * math.pi * f2 / RATE
            v += math.sin(phase[k]) + 0.25 * math.sin(2 * phase[k])
        out.append(v * env(i, n, attack, release))
    return out


def noise(dur, lowpass=0.2, attack=0.01, release=0.7, sweep=None):
    n = int(RATE * dur)
    out = []
    y = 0
    for i in range(n):
        a = lowpass if not sweep else lowpass + (sweep - lowpass) * i / n
        y += a * (random.uniform(-1, 1) - y)
        out.append(y * env(i, n, attack, release))
    return out


def mix(*parts):
    n = max(len(p) + int(o * RATE) for p, o in parts)
    out = [0.0] * n
    for p, offset in parts:
        o = int(offset * RATE)
        for i, s in enumerate(p):
            out[o + i] += s
    return out


# The second pass (v0.9): quieter and drier, to sit under the terminal look.
# Fewer layers, softer edges, nothing longer than it needs to be.

# Hover: a barely-there tick.
write("tick.wav", tone([2000], 0.012, attack=0.001, release=0.9), 0.14)
# Select: one soft blip.
write("select.wav", tone([1046], 0.045, attack=0.002, release=0.8), 0.22)
# Open a panel: a short, low rise.
write("open.wav", mix((tone([392], 0.12, glide=1.5, release=0.7), 0), (noise(0.08, 0.04, 0.01, 0.8), 0)), 0.2)
# Deploy: a muted thump and a clean rising tone.
write("deploy.wav", mix((tone([60], 0.32, attack=0.002, release=0.9), 0),
                        (tone([330], 0.45, glide=2.0, release=0.6), 0.08)), 0.42)
# Cycle done: two soft notes, a fifth apart.
write("done.wav", mix((tone([659], 0.12, release=0.8), 0), (tone([988], 0.22, release=0.85), 0.09)), 0.28)
# Operation complete: a warm three-note rise.
write("complete.wav", mix((tone([523], 0.14), 0), (tone([659], 0.14), 0.1),
                          (tone([784], 0.42, release=0.9), 0.2)), 0.32)
# Waiting on the operator: two short calls, no squelch.
write("radio.wav", mix((tone([1320], 0.05), 0), (tone([1320], 0.05), 0.12)), 0.28)
# Failure: one low falling note.
write("fail.wav", tone([220], 0.4, glide=0.7, release=0.8), 0.34)
